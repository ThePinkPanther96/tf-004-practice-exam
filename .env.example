# Docker host binding. Keep loopback for local use.
BIND_ADDRESS=127.0.0.1
APP_PORT=8080
# Public hosts: link to the corresponding source for the version you are running.
# SOURCE_URL=https://github.com/your-name/your-openprep-fork
# For HTTPS hosting behind exactly one trusted reverse proxy:
# COOKIE_SECURE=true
# TRUST_PROXY=1
